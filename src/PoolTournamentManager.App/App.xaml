<Application x:Class="PoolTournamentManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PoolTournamentManager.App"
             xmlns:converters="clr-namespace:PoolTournamentManager.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0: the active palette - ThemeService replaces this entry at runtime to
                     match the Windows light/dark setting (live-tracked). Light here is just the
                     placeholder shown before ThemeService.Start() runs. -->
                <ResourceDictionary Source="Themes/Palette.Light.xaml" />
                <ResourceDictionary Source="Themes/Generic.xaml" />
                <ResourceDictionary Source="Themes/BracketTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <converters:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibilityConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
