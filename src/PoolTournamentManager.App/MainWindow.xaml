<Window x:Class="PoolTournamentManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pool Tournament Manager" Height="700" Width="1200"
        Icon="Assets/Logo.png"
        Background="{DynamicResource AppBackgroundBrush}"
        Loaded="MainWindow_OnLoaded">
    <Window.Resources>
        <!-- Editable match card for the operator's bracket tree: same seed/name/score look as the
             read-only display (see Themes/BracketTemplates.xaml), but the score cells are TextBoxes
             and a footer carries the table picker + Report control while the match is reportable.
             ElementName=TournamentRoot reaches the tab's TournamentViewModel for the shared command
             and table list. DataContext here is a MatchRowViewModel. -->
        <DataTemplate x:Key="EditableMatchCardTemplate">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="6,5">
                <StackPanel VerticalAlignment="Center">
                    <Grid Height="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Player1Seed}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Player1Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlayer1Winner}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Column="2" Text="{Binding Match.Player1Score, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 IsEnabled="{Binding IsInProgress}" />
                    </Grid>

                    <Border Height="1" Margin="2,4" Background="{DynamicResource AppBorderBrush}" />

                    <Grid Height="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Player2Seed}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Player2Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlayer2Winner}" Value="True">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox Grid.Column="2" Text="{Binding Match.Player2Score, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 IsEnabled="{Binding IsInProgress}" />
                    </Grid>

                    <!-- Before start: table picker + Start button -->
                    <Grid Margin="0,6,0,0" Visibility="{Binding IsStartable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,6,0"
                                  ItemsSource="{Binding DataContext.State.Tables, ElementName=TournamentRoot}"
                                  SelectedValuePath="Id" DisplayMemberPath="Label"
                                  SelectedValue="{Binding Match.TableId}" />
                        <Button Grid.Column="1" Content="Start"
                                Command="{Binding DataContext.StartMatchCommand, ElementName=TournamentRoot}"
                                CommandParameter="{Binding}" Padding="8,2" />
                    </Grid>

                    <!-- While in progress: live elapsed timer + Finish button -->
                    <Grid Margin="0,6,0,0" Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ElapsedDisplay}" VerticalAlignment="Center"
                                   FontFamily="Consolas" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="1" Content="Finish"
                                Command="{Binding DataContext.FinishMatchCommand, ElementName=TournamentRoot}"
                                CommandParameter="{Binding}" Padding="8,2" />
                    </Grid>

                    <!-- Once complete: final duration, part of the match's recorded statistics -->
                    <TextBlock Margin="0,4,0,0" Text="{Binding ElapsedDisplay, StringFormat='Finished in {0}'}"
                               FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding HasFinishedDuration, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A positioned editable match box on the operator bracket canvas. -->
        <DataTemplate x:Key="EditableBracketBoxTemplate">
            <ContentControl Width="{Binding Width}" Height="{Binding Height}"
                            Content="{Binding Match}" ContentTemplate="{StaticResource EditableMatchCardTemplate}" />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource WindowChromeBrush}">
            <StackPanel Orientation="Horizontal" Margin="14,10,14,4">
                <Image Source="Assets/Logo.png" Width="36" Height="36" Margin="0,0,10,0" />
                <TextBlock Text="Pool Tournament Manager" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10">
        <TabItem Header="Players">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Column="0" Grid.Row="0"
                          ItemsSource="{Binding Players}"
                          SelectedItem="{Binding SelectedPlayer}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="120" />
                        <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="120" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160" />
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110" />
                        <DataGridTextColumn Header="Fargo" Binding="{Binding FargoRate}" Width="60" />
                        <DataGridTextColumn Header="TAP" Binding="{Binding TapRating}" Width="70" />
                        <DataGridTextColumn Header="APA 8B" Binding="{Binding ApaEightBallSkill}" Width="60" />
                        <DataGridTextColumn Header="APA 9B" Binding="{Binding ApaNineBallSkill}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Player Details" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

                    <TextBlock Text="First Name" />
                    <TextBox Text="{Binding Editor.FirstName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                    <TextBlock Text="Last Name" />
                    <TextBox Text="{Binding Editor.LastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                    <TextBlock Text="Email" />
                    <TextBox Text="{Binding Editor.Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                    <TextBlock Text="Phone" />
                    <TextBox Text="{Binding Editor.Phone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                    <TextBlock Text="Fargo Rating" />
                    <TextBox Text="{Binding Editor.FargoRate, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,0,0,6" />

                    <TextBlock Text="TAP Rating" />
                    <TextBox Text="{Binding Editor.TapRating, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                    <TextBlock Text="APA 8-Ball Skill (1-9)" />
                    <TextBox Text="{Binding Editor.ApaEightBallSkill, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,0,0,6" />

                    <TextBlock Text="APA 9-Ball Skill (1-9)" />
                    <TextBox Text="{Binding Editor.ApaNineBallSkill, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Margin="0,0,0,6" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="New Player" Command="{Binding AddNewPlayerCommand}" Padding="8,4" Margin="0,0,8,0" />
                        <Button Content="Save" Command="{Binding SavePlayerCommand}" Padding="8,4" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" Margin="0,4,0,0" />
            </Grid>
        </TabItem>

        <TabItem Header="Teams">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <DataGrid Grid.Column="0" Grid.Row="0"
                          ItemsSource="{Binding Teams}"
                          SelectedItem="{Binding SelectedTeam}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Team Name" Binding="{Binding Name}" Width="240" />
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Team Details" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

                    <TextBlock Text="Team Name" />
                    <TextBox Text="{Binding TeamEditor.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="New Team" Command="{Binding AddNewTeamCommand}" Padding="8,4" Margin="0,0,8,0" />
                        <Button Content="Save" Command="{Binding SaveTeamCommand}" Padding="8,4" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" Margin="0,4,0,0" />
            </Grid>
        </TabItem>

        <TabItem Header="Tournament">
            <Grid x:Name="TournamentRoot" DataContext="{Binding Tournament}" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <!-- Left: tournament picker. Creating/configuring tournaments lives on the
                     Tournament Settings tab; this tab operates the tournament selected here. -->
                <Grid Grid.Column="0" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Tournaments" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding State.Tournaments}"
                             SelectedItem="{Binding SelectedTournamentSummary}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Create and configure tournaments on the Tournament Settings tab." />
                </Grid>

                <!-- Right: tables + bracket -->
                <Grid Grid.Column="2" Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" Margin="0,0,0,10" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tables:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" />
                        <ItemsControl ItemsSource="{Binding State.Tables}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="6,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Label}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Add Table" Command="{Binding AddTableCommand}" Padding="6,2" Margin="6,0,0,0" />
                        <Button Content="Save Table Assignments" Command="{Binding SaveAssignmentsCommand}" Padding="6,2" Margin="6,0,0,0" />
                        <Button x:Name="OpenDisplayWindowButton" Content="Open Display Window" Click="OpenDisplayWindowButton_OnClick" Padding="6,2" Margin="16,0,0,0" />
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Add players/teams while the tournament is still pre-play; hidden once any
                         match/game has actually started (see TournamentViewModel.CanAddEntrant).
                         Which picker shows depends on whether the active tournament uses Teams. -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10"
                                Visibility="{Binding CanAddEntrant, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding ActiveTournamentUsesPlayers, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Add Player:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" />
                            <ComboBox Width="200" ItemsSource="{Binding AddablePlayers}" DisplayMemberPath="FullName"
                                      SelectedItem="{Binding SelectedPlayerToAdd}" />
                            <Button Content="Add" Command="{Binding AddEntrantCommand}" Padding="6,2" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding ActiveTournamentUsesTeams, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Add Team:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold" />
                            <ComboBox Width="200" ItemsSource="{Binding AddableTeams}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedTeamToAdd}" />
                            <Button Content="Add" Command="{Binding AddEntrantCommand}" Padding="6,2" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="2" Margin="0,0,0,10" Padding="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            Visibility="{Binding State.Standings.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Standings" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding State.Standings}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="30" />
                                    <DataGridTextColumn Header="Player" Binding="{Binding PlayerName}" Width="160" />
                                    <DataGridTextColumn Header="W" Binding="{Binding Wins}" Width="30" />
                                    <DataGridTextColumn Header="L" Binding="{Binding Losses}" Width="30" />
                                    <DataGridTextColumn Header="Diff" Binding="{Binding PointDifferential}" Width="45" />
                                    <DataGridTextColumn Header="Games %" Binding="{Binding GamesWonPercentageDisplay}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Elimination bracket: same tree as the read-only Display window, with
                         editable boxes (score inputs + table picker + Report on the live match). -->
                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsEliminationBracket, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Width="{Binding Bracket.Width}" Height="{Binding Bracket.Height}" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <ItemsControl ItemsSource="{Binding Bracket.Connectors}" ItemTemplate="{StaticResource BracketConnectorTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Bracket.SectionLabels}"
                                          ItemContainerStyle="{StaticResource CanvasPlacementStyle}"
                                          ItemTemplate="{StaticResource BracketSectionLabelTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Bracket.Headers}"
                                          ItemContainerStyle="{StaticResource CanvasPlacementStyle}"
                                          ItemTemplate="{StaticResource BracketHeaderTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Bracket.Boxes}"
                                          ItemContainerStyle="{StaticResource CanvasPlacementStyle}"
                                          ItemTemplate="{StaticResource EditableBracketBoxTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- Round-robin fallback: simple round-column list, same editable card. -->
                    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding ShowFlatRounds, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding State.Rounds}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,24,0" Width="250">
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding Matches}" ItemTemplate="{StaticResource EditableMatchCardTemplate}">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Margin" Value="0,0,0,10" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Ring game: live rotation, operator controls, and money ledger -->
                    <Grid Grid.Row="3" Visibility="{Binding State.IsRingGame, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding State.RingStatusLine}" FontWeight="Bold" FontSize="15" Margin="0,0,0,10" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Made the 5" Command="{Binding RecordFiveBallCommand}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="Made the 9 (rack over)" Command="{Binding RecordNineBallCommand}" Padding="10,4" Margin="0,0,8,0" />
                            <Button Content="Miss / Next Player" Command="{Binding AdvanceShooterCommand}" Padding="10,4" />
                        </StackPanel>

                        <!-- Rotation: one card per player, current shooter highlighted, cashed-out dimmed -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding State.RingSeats}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,6" Margin="0,0,10,10" Width="150">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentShooter}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCashedOut}" Value="True">
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding RotationLabel}" FontWeight="SemiBold" />
                                            <TextBlock Margin="0,2,0,4">
                                                <Run Text="Net " />
                                                <Run Text="{Binding NetDisplay, Mode=OneWay}" FontWeight="Bold" />
                                            </TextBlock>
                                            <Button Content="Cash Out"
                                                    Command="{Binding DataContext.CashOutCommand, ElementName=TournamentRoot}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanAct}"
                                                    Padding="6,1" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Money ledger -->
                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Ledger" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                            <DataGrid ItemsSource="{Binding State.RingSeats}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding RotationPosition}" Width="30" />
                                    <DataGridTextColumn Header="Player" Binding="{Binding PlayerName}" Width="150" />
                                    <DataGridTextColumn Header="Buy-in" Binding="{Binding BuyInDisplay}" Width="70" />
                                    <DataGridTextColumn Header="Winnings" Binding="{Binding WinningsDisplay}" Width="80" />
                                    <DataGridTextColumn Header="Net" Binding="{Binding NetDisplay}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>

                    <!-- Chip tournament: ad-hoc game entry + live standings -->
                    <Grid Grid.Row="3" Visibility="{Binding State.IsChipTournament, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding State.ChipStatusLine}" FontWeight="Bold" FontSize="15" Margin="0,0,0,10" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                            <TextBlock Text="Winner:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox Width="160" ItemsSource="{Binding State.ChipActiveEntrants}"
                                      DisplayMemberPath="PlayerName" SelectedValuePath="EntrantId"
                                      SelectedValue="{Binding SelectedChipWinnerId}" />
                            <TextBlock Text="beat" VerticalAlignment="Center" Margin="10,0,10,0" />
                            <ComboBox Width="160" ItemsSource="{Binding State.ChipActiveEntrants}"
                                      DisplayMemberPath="PlayerName" SelectedValuePath="EntrantId"
                                      SelectedValue="{Binding SelectedChipLoserId}" />
                            <Button Content="Record Game" Command="{Binding RecordChipGameCommand}" Padding="10,4" Margin="12,0,0,0" />
                        </StackPanel>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding State.ChipStandings}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Place" Binding="{Binding PlaceDisplay}" Width="55" />
                                <DataGridTextColumn Header="Player" Binding="{Binding PlayerName}" Width="180" />
                                <DataGridTextColumn Header="Chips" Binding="{Binding ChipsDisplay}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Prize payouts: entry-fee totals + per-place payouts, shared across every
                         format except Ring Game (see PrizePayoutService/TournamentStateService). -->
                    <Border Grid.Row="4" Margin="0,10,0,0" Padding="8"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                            Visibility="{Binding State.ShowPrizePayouts, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Prize Payouts" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding State.PrizePoolSummaryLine}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding State.PrizePayouts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding PlaceDisplay}" Width="90" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding EntrantName}" Width="180" />
                                            <TextBlock Text="{Binding Payout}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" Margin="0,4,0,0" />
            </Grid>
        </TabItem>

        <TabItem Header="Tournament Settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="20" DataContext="{Binding Tournament}">
                <!-- The create/configure form lives here (moved off the Tournament tab, which now
                     just operates the selected tournament). DataContext is the shared
                     TournamentViewModel, so a tournament created here appears in the Tournament
                     tab's picker. -->
                <TextBlock Text="Create Tournament" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

                <StackPanel Width="340" HorizontalAlignment="Left">
                    <TextBlock Text="Name" />
                    <TextBox Text="{Binding NewTournamentName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                    <TextBlock Text="Game" />
                    <ComboBox ItemsSource="{Binding GameTypes}" SelectedItem="{Binding NewTournamentGameType}" Margin="0,0,0,6" />

                    <TextBlock Text="Format" />
                    <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding NewTournamentFormat}" Margin="0,0,0,6" />

                    <!-- Only Single/Double Elimination can be run with Team entrants. -->
                    <CheckBox Content="Use Teams" IsChecked="{Binding UseTeams}" Margin="0,0,0,6"
                              Visibility="{Binding IsTeamEligibleFormat, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <StackPanel Visibility="{Binding ShowSeedByRating, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Seed by rating" />
                        <ComboBox ItemsSource="{Binding RatingSystems}" SelectedItem="{Binding NewTournamentRatingSystem}" Margin="0,0,0,6" />
                    </StackPanel>

                    <!-- Required for every format except Ring Game; matches cannot be started
                         until the tournament has this many tables. -->
                    <StackPanel Visibility="{Binding RequiresTableCount, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Number of tables" />
                        <TextBox Text="{Binding NewTournamentTableCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                    </StackPanel>

                    <!-- Ring-game-only setup: buy-in and money-ball payouts -->
                    <StackPanel Visibility="{Binding IsCreatingRingGame, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Buy-in ($)" />
                        <TextBox Text="{Binding NewRingBuyIn}" Margin="0,0,0,6" />
                        <TextBlock Text="5-ball payout ($)" />
                        <TextBox Text="{Binding NewRingFivePayout}" Margin="0,0,0,6" />
                        <TextBlock Text="9-ball payout ($)" />
                        <TextBox Text="{Binding NewRingNinePayout}" Margin="0,0,0,6" />
                    </StackPanel>

                    <!-- Chip-tournament-only setup: starting chips -->
                    <StackPanel Visibility="{Binding IsCreatingChipTournament, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Starting chips per player" />
                        <TextBox Text="{Binding NewChipStartingChips}" Margin="0,0,0,6" />
                    </StackPanel>

                    <!-- Entry fee, host cut, and place-based prize payouts - every format except
                         Ring Game, which has its own separate buy-in/payout model. -->
                    <StackPanel Visibility="{Binding ShowEntryFeeSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Entry fee per entrant ($)" />
                        <TextBox Text="{Binding NewEntryFee, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding TotalEntryFeesDisplay, StringFormat='Total entry fees collected: {0}'}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="Tournament host fee (%)" />
                        <TextBox Text="{Binding NewHostFeePercentage, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                        <TextBlock Text="Number of payout places" />
                        <TextBox Text="{Binding NewPayoutPlaceCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />

                        <ItemsControl ItemsSource="{Binding NewPrizePlaceInputs}" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding PlaceLabel}" Width="90" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding Percentage, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                        <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Visibility="{Binding NewPayoutPlaceCount, Converter={StaticResource CountToVisibilityConverter}}" Margin="0,0,0,6">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPrizePlacePercentageValid}" Value="False">
                                            <Setter Property="Foreground" Value="Red" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="Total: " /><Run Text="{Binding PrizePlacePercentageTotal, Mode=OneWay}" /><Run Text="% (must equal 100%)" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowPlayerEntrants, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <TextBlock Text="Entrants" VerticalAlignment="Center" />
                            <Button Content="Refresh" Command="{Binding LoadEntrantCandidatesCommand}" Padding="6,0" Margin="8,0,0,0" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding EntrantCandidates}" Height="200" Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Player.FullName}" IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Visibility="{Binding UseTeams, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                            <TextBlock Text="Entrants (Teams)" VerticalAlignment="Center" />
                            <Button Content="Refresh" Command="{Binding LoadTeamCandidatesCommand}" Padding="6,0" Margin="8,0,0,0" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding TeamCandidates}" Height="200" Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Team.Name}" IsChecked="{Binding IsSelected}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <Button Content="Create Tournament" Command="{Binding CreateTournamentCommand}" Padding="8,4" HorizontalAlignment="Left" />
                </StackPanel>

                <Border Height="1" Width="340" Margin="0,20" HorizontalAlignment="Left"
                        Background="{DynamicResource AppBorderBrush}" />

                <TextBlock Text="Appearance" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                <TextBlock TextWrapping="Wrap" Width="460" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="The app follows your Windows theme automatically. It switches between light and dark mode to match your Windows &quot;Choose your mode&quot; setting, updating live whenever you change it - there's nothing to configure here." />
            </StackPanel>
            </ScrollViewer>
        </TabItem>
        </TabControl>
    </Grid>
</Window>
