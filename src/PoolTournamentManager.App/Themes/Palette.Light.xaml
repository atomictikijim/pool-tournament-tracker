<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    The single light palette. The app no longer has selectable color schemes - it just follows the
    Windows "choose your color mode" setting, so there is one light palette and one dark palette
    (Palette.Dark.xaml). These are neutral Windows 11-style greys with the standard system accent
    blue, chosen to sit unobtrusively next to whatever the OS chrome looks like. Key names must
    match Palette.Dark.xaml exactly - ThemeService swaps the whole dictionary as a unit and every
    themed brush is a DynamicResource, so switching modes repaints instantly with no restart.
    -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
    <!-- Chrome matches the background so the title bar/tab strip read as one neutral surface. -->
    <SolidColorBrush x:Key="WindowChromeBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#D6D6D6" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C5C5C" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="AccentPrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#386890" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#CFE4F7" />

</ResourceDictionary>
