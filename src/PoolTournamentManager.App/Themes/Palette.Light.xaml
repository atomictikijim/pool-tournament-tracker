<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Light palette - same swamp/gator-derived hues as Palette.Dark.xaml, re-balanced for a pale
    background: the chartreuse accent becomes a deeper forest green so it stays readable on white,
    and the teal shirt blue is darkened slightly for the same reason. Key names must match
    Palette.Dark.xaml exactly - ThemeService swaps the two dictionaries as a unit.
    -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5FAF1" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F0F5EA" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#C9D9BE" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#16241A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#57684F" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#4C8C2B" />
    <SolidColorBrush x:Key="AccentPrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#2A5F74" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#D9E8C9" />

</ResourceDictionary>
