<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    The single dark palette - neutral Windows 11-style graphite with the standard system accent
    blue. Its counterpart is Palette.Light.xaml; the app follows the Windows light/dark setting
    and swaps between the two. Key names must match Palette.Light.xaml exactly - ThemeService swaps
    the whole dictionary as a unit and every themed brush is a DynamicResource, so switching modes
    repaints instantly with no restart.
    -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
    <!-- Chrome matches the background so the title bar/tab strip read as one neutral surface. -->
    <SolidColorBrush x:Key="WindowChromeBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#333333" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#3D3D3D" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A0A0" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentPrimaryTextBrush" Color="#00243D" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#7FA8CC" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#38495A" />

</ResourceDictionary>
