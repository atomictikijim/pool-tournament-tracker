<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Grey light palette - same structure/shading as Palette.Green.Light.xaml, desaturated to a
    graphite/steel neutral. Key names must match every other Palette.*.xaml exactly - ThemeService
    swaps dictionaries as a unit.
    -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F5F6" />
    <SolidColorBrush x:Key="WindowChromeBrush" Color="#EDEEEF" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#EDEEEF" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#CBCDCF" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1D1F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C6266" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#4A6480" />
    <SolidColorBrush x:Key="AccentPrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#8C6A3E" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#DADDE0" />

</ResourceDictionary>
