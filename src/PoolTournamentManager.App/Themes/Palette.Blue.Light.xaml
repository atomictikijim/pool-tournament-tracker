<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Blue light palette - same structure/shading as Palette.Green.Light.xaml, hue rotated to a sky
    blue. Key names must match every other Palette.*.xaml exactly - ThemeService swaps
    dictionaries as a unit.
    -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F0F5FA" />
    <SolidColorBrush x:Key="WindowChromeBrush" Color="#E8EEF5" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#EAF0F5" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#BED0D9" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#16212A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4F6068" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#2B6CB2" />
    <SolidColorBrush x:Key="AccentPrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#74602A" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#C9DDE8" />

</ResourceDictionary>
