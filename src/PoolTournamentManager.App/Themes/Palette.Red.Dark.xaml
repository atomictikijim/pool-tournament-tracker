<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Red dark palette - same structure/shading as Palette.Green.Dark.xaml (deep near-black surface,
    a vivid mid-bright accent, muted borders, pale text) with the hue rotated to a brick/crimson
    red. Key names must match every other Palette.*.xaml exactly - ThemeService swaps dictionaries
    as a unit.
    -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#2B0D0D" />
    <SolidColorBrush x:Key="WindowChromeBrush" Color="#E2604C" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#3A1212" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#451616" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#5C2B2B" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5E7E4" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C79B96" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#E2604C" />
    <SolidColorBrush x:Key="AccentPrimaryTextBrush" Color="#250D08" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#3E708C" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#331010" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#562727" />

</ResourceDictionary>
