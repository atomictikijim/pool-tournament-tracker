<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Blue dark palette - same structure/shading as Palette.Green.Dark.xaml, hue rotated to a sky
    blue with a warm amber secondary accent. Key names must match every other Palette.*.xaml
    exactly - ThemeService swaps dictionaries as a unit.
    -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1A2A" />
    <SolidColorBrush x:Key="WindowChromeBrush" Color="#4A9FE0" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#12283A" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#163247" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#2B4A5C" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4F0F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#96B3C7" />

    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#4A9FE0" />
    <SolidColorBrush x:Key="AccentPrimaryTextBrush" Color="#08182B" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#8C6A3E" />

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#102232" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#27455A" />

</ResourceDictionary>
