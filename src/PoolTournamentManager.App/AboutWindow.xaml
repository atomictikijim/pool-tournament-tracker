<Window x:Class="PoolTournamentManager.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="About Pool Tournament Manager"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="Assets/Logo.png"
        Background="{DynamicResource AppBackgroundBrush}">
    <!-- Standard About box: logo + name + version, description, copyright/license, a clickable
         repository link, and the runtime. DataContext is an AboutInfo (set in code-behind); all
         colors are DynamicResource brushes so it follows the live light/dark theme. -->
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="Assets/Logo.png" Width="56" Height="56" Margin="0,0,14,0"
                   VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="{Binding VersionDisplay}" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,14" />

        <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,0,0,14" />

        <TextBlock Text="{Binding Copyright}" Margin="0,0,0,6" />
        <TextBlock Text="{Binding License}" TextWrapping="Wrap" Margin="0,0,0,6"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding CommercialNote}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{DynamicResource TextSecondaryBrush}" />

        <TextBlock Margin="0,0,0,4">
            <Run Text="Project: " Foreground="{DynamicResource TextSecondaryBrush}" />
            <!-- Both bindings must be OneWay: AboutInfo's properties are get-only, and Run.Text
                 (and NavigateUri via string→Uri) would otherwise try to write back and throw. -->
            <Hyperlink NavigateUri="{Binding RepositoryUrl, Mode=OneWay}" RequestNavigate="Hyperlink_RequestNavigate"
                       Foreground="{DynamicResource AccentPrimaryBrush}">
                <Run Text="{Binding RepositoryUrl, Mode=OneWay}" />
            </Hyperlink>
        </TextBlock>
        <TextBlock Text="{Binding Runtime}" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />

        <Button Content="Close" Click="Close_Click" IsDefault="True" IsCancel="True"
                MinWidth="90" Padding="8,4" Margin="0,16,0,0" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
