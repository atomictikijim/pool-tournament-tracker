<Window x:Class="PoolTournamentManager.App.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pool Tournament Manager - Display" Height="700" Width="1200"
        Icon="Assets/Logo.png"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <!-- One player's line inside a match box. Winner highlight is driven purely by the
             DataTrigger on IsWinner against named parts (defaults live in Styles, never as local
             values) so the trigger can win - see NOTES.md precedence traps. -->
        <DataTemplate x:Key="PlayerLineTemplate">
            <Border x:Name="LineRoot" CornerRadius="3" Margin="2,1">
                <Grid Height="26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NameText" Grid.Column="0" Text="{Binding Name}"
                               VerticalAlignment="Center" Margin="10,0,6,0" FontSize="14"
                               TextTrimming="CharacterEllipsis" />
                    <Border x:Name="ScoreCell" Grid.Column="1" CornerRadius="0,3,3,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
                            </Style>
                        </Border.Style>
                        <TextBlock x:Name="ScoreText" Text="{Binding ScoreDisplay}" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWinner}" Value="True">
                    <Setter TargetName="LineRoot" Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                    <Setter TargetName="ScoreCell" Property="Background" Value="Transparent" />
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource AccentPrimaryTextBrush}" />
                    <Setter TargetName="NameText" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="ScoreText" Property="Foreground" Value="{DynamicResource AccentPrimaryTextBrush}" />
                    <Setter TargetName="ScoreText" Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The card body for a MatchRowViewModel: two player lines + divider. -->
        <DataTemplate x:Key="MatchCardTemplate">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="5">
                <StackPanel VerticalAlignment="Center">
                    <ContentControl Content="{Binding Player1Line}" ContentTemplate="{StaticResource PlayerLineTemplate}" />
                    <Border Height="1" Margin="8,0" Background="{DynamicResource AppBorderBrush}" />
                    <ContentControl Content="{Binding Player2Line}" ContentTemplate="{StaticResource PlayerLineTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A positioned match box on the bracket canvas: sizes the card to its computed extent. -->
        <DataTemplate x:Key="BracketBoxTemplate">
            <ContentControl Width="{Binding Width}" Height="{Binding Height}"
                            Content="{Binding Match}" ContentTemplate="{StaticResource MatchCardTemplate}" />
        </DataTemplate>

        <!-- Places each canvas item at its computed (X, Y). -->
        <Style x:Key="CanvasPlacementStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource WindowChromeBrush}" Margin="-20,-20,-20,16" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/Logo.png" Width="48" Height="48" Margin="0,0,14,0" />
                <StackPanel>
                    <TextBlock Text="{Binding State.ActiveTournament.Name, TargetNullValue='No tournament selected'}"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="32" FontWeight="Bold" />
                    <TextBlock Text="{Binding State.ActiveTournament.Status}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Now Playing" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding TableAssignments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,12,0" Background="{DynamicResource CardBackgroundBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding Table.Label}" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Live bracket tree (single/double elimination), styled after digitalpool.com: round
             columns left-to-right, each match centred between its two feeders, elbow connectors,
             winner rows highlighted. Four overlaid Canvas layers share one coordinate space. -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEliminationBracket, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid Width="{Binding Bracket.Width}" Height="{Binding Bracket.Height}" HorizontalAlignment="Left" VerticalAlignment="Top">
                <!-- Layer 1: connector lines -->
                <ItemsControl ItemsSource="{Binding Bracket.Connectors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Layer 2: section labels (Winners/Losers Bracket) -->
                <ItemsControl ItemsSource="{Binding Bracket.SectionLabels}" ItemContainerStyle="{StaticResource CanvasPlacementStyle}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Width="{Binding Width}"
                                       Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Layer 3: round headers -->
                <ItemsControl ItemsSource="{Binding Bracket.Headers}" ItemContainerStyle="{StaticResource CanvasPlacementStyle}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Width="{Binding Width}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Layer 4: match boxes -->
                <ItemsControl ItemsSource="{Binding Bracket.Boxes}"
                              ItemContainerStyle="{StaticResource CanvasPlacementStyle}"
                              ItemTemplate="{StaticResource BracketBoxTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Round-robin fallback: simple round-column list -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowFlatRounds, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding State.Rounds}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,28,0" Width="280">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="18" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Matches}" ItemTemplate="{StaticResource MatchCardTemplate}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,0,12" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Ring game: read-only live rotation + money board -->
        <StackPanel Grid.Row="2" Visibility="{Binding State.IsRingGame, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding State.RingStatusLine}" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,14" />
            <ItemsControl ItemsSource="{Binding State.RingSeats}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14,10" Margin="0,0,14,14" Width="220">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentShooter}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                            <Setter Property="BorderThickness" Value="3" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCashedOut}" Value="True">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding RotationLabel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" />
                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" Margin="0,4,0,0">
                                    <Run Text="Net " />
                                    <Run Text="{Binding NetDisplay, Mode=OneWay}" />
                                    <Run Text="  ·  Won " />
                                    <Run Text="{Binding WinningsDisplay, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>
